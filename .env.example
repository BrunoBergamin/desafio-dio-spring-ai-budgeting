# Copie este arquivo para .env (na raiz do projeto) e preencha.
# O .env esta no .gitignore: ele NUNCA vai para o GitHub.

# ---------- IA ----------
# Perfil gratuito (Groq) - crie a chave em https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_aqui

# Perfil padrao (OpenAI) - crie em https://platform.openai.com/api-keys
# Necessario so para a resposta falada em MP3
# OPENAI_API_KEY=sk_sua_chave_aqui

# ---------- Autenticacao ----------
# Segredo do JWT (minimo 32 caracteres). Gere um com:  openssl rand -base64 48
APP_JWT_SECRET=troque-este-valor-por-um-segredo-longo-de-verdade-com-32-ou-mais

# ---------- Perfis ----------
# "groq" (gratis) ou vazio para OpenAI. Para MySQL no Docker: "groq,mysql"
SPRING_PROFILES_ACTIVE=groq
