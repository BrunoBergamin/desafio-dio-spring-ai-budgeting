# Copie este arquivo para .env (na raiz do projeto) e preencha a chave que você for usar.
# O .env está no .gitignore: ele NUNCA vai para o GitHub.

# Perfil gratuito (Groq) - crie em https://console.groq.com/keys
# Rode com: ./mvnw spring-boot:run -Dspring-boot.run.profiles=groq
GROQ_API_KEY=gsk_sua_chave_aqui

# Perfil padrão (OpenAI) - crie em https://platform.openai.com/api-keys
# Necessário para a resposta falada em MP3
OPENAI_API_KEY=sk_sua_chave_aqui
