# Copie este arquivo para .env (na raiz do projeto) e preencha.
# O .env esta no .gitignore: ele NUNCA vai para o GitHub.

# ---------- IA ----------
# Perfil gratuito (Groq) - crie a chave em https://console.groq.com/keys
GROQ_API_KEY=gsk_sua_chave_aqui

# Perfil padrao (OpenAI) - crie em https://platform.openai.com/api-keys
# Necessario so para a resposta falada em MP3
# OPENAI_API_KEY=sk_sua_chave_aqui

# ---------- Modo demonstracao ----------
# true (padrao): o site entra sozinho na conta demo (demo@lumi.local), com gastos de exemplo, sem senha.
# false: cadastro e login normais, para uso real.
APP_DEMO_ENABLED=true

# ---------- Autenticacao ----------
# Segredo do JWT (minimo 32 caracteres). Gere um com:  openssl rand -base64 48
APP_JWT_SECRET=troque-este-valor-por-um-segredo-longo-de-verdade-com-32-ou-mais

# ---------- WhatsApp (opcional, perfil "whatsapp") ----------
# Chave que protege a Evolution API (invente uma, 32+ caracteres):  openssl rand -hex 16
EVOLUTION_API_KEY=troque-por-uma-chave-longa-para-a-evolution
# Segredo do webhook (minimo 16 caracteres):  openssl rand -hex 16
WHATSAPP_WEBHOOK_SECRET=troque-por-um-segredo-do-webhook
# Responder a numeros nao vinculados com um convite? Deixe false se o WhatsApp pareado for pessoal
WHATSAPP_REPLY_UNKNOWN=false

# ---------- Perfis ----------
# "groq" (gratis) ou vazio para OpenAI. MySQL no Docker: "groq,mysql". WhatsApp: "groq,whatsapp"
SPRING_PROFILES_ACTIVE=groq
